{
    "name": "sidetower/laravel",
    "description": "Laravel SDK for Sidetower: server health, scheduled task check-ins, deploys and AI usage.",
    "keywords": ["laravel", "monitoring", "health", "ai", "cost", "sidetower"],
    "homepage": "https://sidetower.com",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Sidetower\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sidetower\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Sidetower\\Laravel\\SidetowerServiceProvider"
            ],
            "aliases": {
                "Sidetower": "Sidetower\\Laravel\\Facades\\Sidetower"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "protocol:sync": "@php tests/Protocol/sync.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
