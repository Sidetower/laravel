{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.json",
  "title": "Protocol v1: the body of POST /v1/ingest",
  "description": "The whole body is valid only when every item is. The server is more forgiving: it accepts the valid items of a request and lists the others in 'rejected'. A source.environment that differs from the key's environment is refused as environment_mismatch, which a schema cannot express.",
  "type": "object",
  "required": ["protocol", "sdk", "items"],
  "properties": {
    "protocol": { "const": 1 },
    "sdk": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "environment": { "$ref": "common.json#/$defs/environment" },
        "release": { "type": "string", "minLength": 1, "maxLength": 100 },
        "host": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "sentAt": { "$ref": "common.json#/$defs/timestamp" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "item.json" }
    }
  }
}
